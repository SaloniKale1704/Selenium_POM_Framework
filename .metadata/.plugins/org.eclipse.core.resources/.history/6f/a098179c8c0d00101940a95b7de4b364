package com.examples.UiTests;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.Select;

import com.base.BaseTest;
import com.base.PageInitializer;
import com.opencsv.exceptions.CsvValidationException;

public class Test01 extends BaseTest {

	public static void main(String[] args) throws Throwable {
		try {
			// Launch browser
			setUp();

			// Login Page
			PageInitializer.loginPage.enterCredentials(username, password);
			PageInitializer.loginPage.clickLoginBtn();

			// Home Page
			PageInitializer.homePage.selectHighToLowRange(testData.get("range"));
			PageInitializer.homePage.searchItem(testData.get("itemToSearch"));
			PageInitializer.homePage.getItemPrice();
			PageInitializer.homePage.addToCart();

			// Cart Page
			PageInitializer.cartPage.goToCartPage();
			PageInitializer.cartPage.verifyItemQty(testData.get("quantity"));
			PageInitializer.cartPage.clickCheckoutBtn();

			// Checkout Page
			PageInitializer.checkoutPage.enterChecoutInfo(testData.get("checkout_firstName"),
					testData.get("checkout_lastName"), testData.get("checkout_pincode"));
			PageInitializer.checkoutPage.verifyItemPricesWithTotal();
			PageInitializer.checkoutPage.ValidateOrderConfirmation(testData.get("orderConfirmationText"));

		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			// Close Browser
			tearDown();
		}

	}

}
