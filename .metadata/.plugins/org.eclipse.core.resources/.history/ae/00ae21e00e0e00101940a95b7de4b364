package com.utils;


import java.io.File;
import java.text.SimpleDateFormat;
import java.util.Date;

import com.aventstack.extentreports.ExtentReports;
import com.aventstack.extentreports.reporter.ExtentSparkReporter;

public class ExtentManager {
	
	public static ExtentReports extent;
	
	private static final String ExtentReport_FOLDER = "src/test/resources/Reports02/"; // Correct folder path

	public static ExtentReports getInstance() {
		if(extent == null) {
			createInstance();
		}		
		return extent;
	}
	
	private static void createInstance() {
			
			new File(ExtentReport_FOLDER).mkdirs();
		
			String timeStamp = new SimpleDateFormat("yyyy-MM-dd_HH-mm-ss").format(new Date());
			String reportPath = ExtentReport_FOLDER+ "ExtentReport_"+ timeStamp + ".html";
			
			ExtentSparkReporter reporter = new ExtentSparkReporter(reportPath);
			reporter.config().setReportName("Automation Test Report");
			reporter.config().setDocumentTitle("Test Execution Report");
			
			extent = new ExtentReports();
			extent.attachReporter(reporter);
			extent.setSystemInfo("Tester", "Saloni Kale");
			extent.setSystemInfo("Environment", "QA");
			
		}
		
	
}
